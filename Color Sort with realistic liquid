<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101827">
<title>Color Sort Puzzle | PLAYZO</title>
<style>
:root {
  --bg: #101827;
  --panel: #1a2940;
  --panel2: #202f46;
  --mint: #65e6c2;
  --purple: #8050e8;
  --text: #f7f9ff;
  --muted: #aab6c8;
}
* { box-sizing: border-box; }
body {
  margin: 0; min-height: 100vh; padding: 18px 12px 34px;
  background: radial-gradient(ellipse at 50% 28%, #1b2a43 0%, var(--bg) 62%);
  color: var(--text); font-family: Arial, Helvetica, sans-serif; text-align: center;
}
header {
  max-width: 680px; margin: 0 auto 38px; display: flex;
  align-items: center; justify-content: space-between;
}
.logo { color: var(--mint); font-size: 25px; font-weight: 900; text-decoration: none; }
.home { color: white; text-decoration: none; font-size: 14px; }
h1 { font-size: clamp(27px, 6vw, 40px); margin: 0 0 10px; letter-spacing: .3px; }
.subtitle { color: var(--muted); margin: 0 0 28px; font-size: 16px; }
.stats {
  max-width: 560px; margin: 0 auto 28px; display: grid;
  grid-template-columns: repeat(3, 1fr); gap: 9px;
}
.stat { background: var(--panel2); border-radius: 18px; padding: 15px 6px; }
.stat small { display: block; color: var(--muted); font-size: 11px; margin-bottom: 7px; }
.stat strong { color: var(--mint); font-size: 25px; }
.game-panel {
  max-width: 680px; margin: 0 auto; padding: 28px 15px 22px;
  background: linear-gradient(145deg, #1b2a40, #172438);
  border: 1px solid rgba(255,255,255,.08); border-radius: 28px;
  box-shadow: 0 18px 55px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.04);
}
#board {
  position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 34px 10px; max-width: 590px; margin: 0 auto; padding: 8px 0 18px;
}
.tube-wrap { min-width: 0; display: flex; justify-content: center; align-items: flex-end; }
.tube {
  position: relative; width: min(100%, 88px); height: clamp(190px, 54vw, 278px);
  border-left: 6px solid rgba(195,216,239,.78);
  border-right: 6px solid rgba(195,216,239,.78);
  border-bottom: 6px solid rgba(195,216,239,.78);
  border-top: 0; border-radius: 0 0 35px 35px;
  background: linear-gradient(90deg, rgba(255,255,255,.10), rgba(255,255,255,.025) 24%, rgba(255,255,255,.08) 72%, rgba(255,255,255,.02));
  box-shadow: inset 7px 0 10px rgba(255,255,255,.045), inset -7px 0 10px rgba(0,0,0,.12), 0 8px 16px rgba(0,0,0,.13);
  overflow: hidden; cursor: pointer; isolation: isolate;
  transition: transform .18s ease, border-color .18s ease, filter .18s ease;
}
.tube::before {
  content: ""; position: absolute; z-index: 5; pointer-events: none;
  left: 5px; top: 8px; bottom: 16px; width: 4px; border-radius: 8px;
  background: linear-gradient(180deg, rgba(255,255,255,.42), rgba(255,255,255,.04));
}
.tube::after {
  content: ""; position: absolute; z-index: 5; pointer-events: none;
  right: 5px; top: 12px; bottom: 17px; width: 2px; border-radius: 8px;
  background: rgba(255,255,255,.12);
}
.tube.selected {
  transform: translateY(-12px);
  border-color: #75f0d0;
  filter: drop-shadow(0 0 12px rgba(101,230,194,.48));
}
.liquid-stack {
  position: absolute; inset: 5px 3px 3px; display: flex;
  flex-direction: column-reverse; overflow: hidden; border-radius: 0 0 27px 27px;
}
.liquid {
  position: relative; flex: 0 0 25%; width: 100%;
  border-radius: 9px 9px 7px 7px;
  border-top: 1px solid rgba(255,255,255,.26);
  box-shadow: inset 0 5px 8px rgba(255,255,255,.16), inset 0 -7px 10px rgba(0,0,0,.16);
  background-image: linear-gradient(180deg, rgba(255,255,255,.13), transparent 36%, rgba(0,0,0,.13));
}
.liquid + .liquid { margin-top: -2px; }
.liquid.top-liquid { border-radius: 11px 11px 7px 7px; }
.liquid.top-liquid::before {
  content: ""; position: absolute; left: -1px; right: -1px; top: -4px; height: 13px;
  border-radius: 50%;
  background: inherit; filter: brightness(1.22);
  border-top: 2px solid rgba(255,255,255,.56);
  box-shadow: 0 2px 5px rgba(0,0,0,.14);
}
.tube.empty .liquid-stack { background: transparent; }
.tube.pouring { animation: tubeTilt .42s ease-in-out; }
@keyframes tubeTilt {
  0%,100% { transform: rotate(0); }
  35% { transform: rotate(-5deg) translateY(-5px); }
  70% { transform: rotate(3deg); }
}
#streamLayer { position: absolute; inset: 0; pointer-events: none; overflow: visible; z-index: 10; }
.stream {
  position: absolute; height: 8px; border-radius: 100%; transform-origin: left center;
  opacity: 0; box-shadow: 0 0 9px currentColor, 0 0 18px currentColor;
  animation: streamPour .42s ease-out forwards;
}
@keyframes streamPour {
  0% { opacity: 0; transform: scaleX(.05) rotate(var(--angle)); }
  18% { opacity: .95; }
  78% { opacity: .9; }
  100% { opacity: 0; transform: scaleX(1) rotate(var(--angle)); }
}
.controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px; }
button {
  border: 0; border-radius: 28px; padding: 14px 21px; min-width: 112px;
  color: white; background: var(--purple); font-size: 14px; font-weight: 800;
  cursor: pointer; box-shadow: 0 5px 14px rgba(0,0,0,.18);
  touch-action: manipulation;
}
button:active { transform: scale(.97); }
button:disabled { opacity: .38; cursor: default; }
#message { min-height: 25px; margin: 18px 0 0; color: var(--muted); font-size: 14px; }
#winBanner { display:none; margin: 10px auto 0; color: var(--mint); font-weight: 800; font-size: 20px; }
.help { max-width: 600px; margin: 20px auto 0; color: var(--muted); font-size: 12px; line-height: 1.55; }
@media (max-width: 390px) {
  #board { gap: 25px 6px; }
  .tube { width: 66px; height: 190px; border-width: 0 5px 5px; border-radius: 0 0 29px 29px; }
  .game-panel { padding-left: 9px; padding-right: 9px; }
  button { min-width: 96px; padding: 13px 14px; }
}
</style>
</head>
<body>
<header>
  <a class="logo" href="./index.html">🎮 PLAYZO</a>
  <a class="home" href="./index.html">← Home</a>
</header>

<h1>🎨 COLOR SORT</h1>
<p class="subtitle">Pour, sort and solve the colourful puzzle!</p>

<section class="stats">
  <div class="stat"><small>MOVES</small><strong id="moves">0</strong></div>
  <div class="stat"><small>TIME</small><strong id="time">0s</strong></div>
  <div class="stat"><small>BEST MOVES</small><strong id="best">--</strong></div>
</section>

<main class="game-panel">
  <div id="board" aria-label="Color sorting tubes">
    <div id="streamLayer"></div>
  </div>
  <div class="controls">
    <button id="undoBtn" type="button" disabled>↶ UNDO</button>
    <button id="restartBtn" type="button">↻ RESTART</button>
    <button id="newBtn" type="button">NEW GAME</button>
  </div>
  <div id="message" aria-live="polite">Tap a tube, then tap another tube to pour.</div>
  <div id="winBanner">🎉 Puzzle solved! Excellent work.</div>
</main>
<p class="help">Rules: pour only onto an empty tube or a tube with the same top colour. Matching top layers move together. Each tube holds four layers. Every new puzzle is generated from a solved board by reversible scrambling, so it has a known solution.</p>

<script>
(() => {
  "use strict";

  const CAPACITY = 4;
  const COLORS = [
    { name: "Aqua", value: "#08c99a" },
    { name: "Blue", value: "#2588f5" },
    { name: "Pink", value: "#f044a4" },
    { name: "Yellow", value: "#ffb900" },
    { name: "Purple", value: "#a83fe8" },
    { name: "Red", value: "#f23c3c" }
  ];
  const BEST_KEY = "playzoColorSortBestMovesV2";

  const boardEl = document.getElementById("board");
  const movesEl = document.getElementById("moves");
  const timeEl = document.getElementById("time");
  const bestEl = document.getElementById("best");
  const undoBtn = document.getElementById("undoBtn");
  const messageEl = document.getElementById("message");
  const winBanner = document.getElementById("winBanner");

  let board = [];
  let startingBoard = [];
  let history = [];
  let selected = null;
  let moves = 0;
  let seconds = 0;
  let timer = null;
  let started = false;
  let finished = false;

  const cloneBoard = value => value.map(tube => tube.slice());
  const topRun = tube => {
    if (!tube.length) return 0;
    let count = 1;
    for (let i = tube.length - 2; i >= 0 && tube[i] === tube[tube.length - 1]; i--) count++;
    return count;
  };

  // Build a solved board, then perform reversible split-pours backwards.
  // Reversing those pours is a legal solution for every generated puzzle.
  function generatePuzzle() {
    const solved = COLORS.map((_, i) => Array(CAPACITY).fill(i));
    solved.push([], []);
    const state = cloneBoard(solved);
    let previous = "";

    for (let step = 0; step < 105; step++) {
      const choices = [];
      for (let from = 0; from < state.length; from++) {
        const source = state[from];
        if (!source.length) continue;
        const run = topRun(source);
        const color = source[source.length - 1];

        for (let to = 0; to < state.length; to++) {
          if (to === from) continue;
          const target = state[to];
          const free = CAPACITY - target.length;
          if (free <= 0) continue;
          if (target.length && target[target.length - 1] === color) continue;

          const maxTake = Math.min(run, free);
          for (let amount = 1; amount <= maxTake; amount++) {
            if (amount === run && amount !== source.length) continue;
            if (amount === source.length && target.length === 0) continue;
            const key = from + ":" + to + ":" + amount;
            if (key === previous) continue;
            choices.push({ from, to, amount, key });
          }
        }
      }
      if (!choices.length) break;

      const move = choices[Math.floor(Math.random() * choices.length)];
      for (let i = 0; i < move.amount; i++) {
        state[move.to].push(state[move.from].pop());
      }
      previous = move.to + ":" + move.from + ":" + move.amount;
    }

    const isTriviallySolved = state.every(t =>
      !t.length || (t.length === CAPACITY && t.every(v => v === t[0]))
    );
    if (isTriviallySolved) return generatePuzzle();
    return state;
  }

  function canPour(from, to) {
    if (from === to || !board[from] || !board[from].length) return false;
    const source = board[from], target = board[to];
    if (target.length >= CAPACITY) return false;
    return !target.length || target[target.length - 1] === source[source.length - 1];
  }

  function isSolved() {
    return board.every(tube => tube.length === 0 ||
      (tube.length === CAPACITY && tube.every(color => color === tube[0])));
  }

  function startTimer() {
    if (started || finished) return;
    started = true;
    timer = setInterval(() => {
      seconds++;
      timeEl.textContent = seconds + "s";
    }, 1000);
  }

  function stopTimer() {
    if (timer) clearInterval(timer);
    timer = null;
  }

  function updateStats() {
    movesEl.textContent = moves;
    timeEl.textContent = seconds + "s";
    undoBtn.disabled = history.length === 0 || finished;
    const best = localStorage.getItem(BEST_KEY);
    bestEl.textContent = best === null ? "--" : best;
  }

  function render() {
    const streamLayer = document.getElementById("streamLayer");
    boardEl.innerHTML = "";
    boardEl.appendChild(streamLayer);

    board.forEach((tube, index) => {
      const wrap = document.createElement("div");
      wrap.className = "tube-wrap";
      const tubeEl = document.createElement("div");
      tubeEl.className = "tube" + (tube.length ? "" : " empty") +
        (selected === index ? " selected" : "");
      tubeEl.dataset.index = index;
      tubeEl.setAttribute("role", "button");
      tubeEl.setAttribute("aria-label", "Tube " + (index + 1) + ", " + tube.length + " layers");

      const stack = document.createElement("div");
      stack.className = "liquid-stack";

      tube.forEach((colorIndex, layerIndex) => {
        const liquid = document.createElement("div");
        liquid.className = "liquid" +
          (layerIndex === tube.length - 1 ? " top-liquid" : "");
        liquid.style.backgroundColor = COLORS[colorIndex].value;
        liquid.style.backgroundImage =
          "linear-gradient(180deg, rgba(255,255,255,.20), transparent 34%, rgba(0,0,0,.15)), linear-gradient(90deg, rgba(255,255,255,.12), transparent 28%, rgba(0,0,0,.08))";
        liquid.title = COLORS[colorIndex].name;
        stack.appendChild(liquid);
      });

      tubeEl.appendChild(stack);
      tubeEl.addEventListener("click", () => handleTubeTap(index));
      wrap.appendChild(tubeEl);
      boardEl.appendChild(wrap);
    });
    updateStats();
  }

  function animatePour(from, to, colorIndex) {
    const tubes = boardEl.querySelectorAll(".tube");
    const source = tubes[from], target = tubes[to];
    if (!source || !target) return;

    source.classList.add("pouring");
    target.classList.add("pouring");

    const boardRect = boardEl.getBoundingClientRect();
    const a = source.getBoundingClientRect();
    const b = target.getBoundingClientRect();
    const x1 = a.left + a.width / 2 - boardRect.left;
    const y1 = a.top + 25 - boardRect.top;
    const x2 = b.left + b.width / 2 - boardRect.left;
    const y2 = b.top + 25 - boardRect.top;
    const dx = x2 - x1, dy = y2 - y1;
    const length = Math.sqrt(dx * dx + dy * dy);
    const angle = Math.atan2(dy, dx) * 180 / Math.PI;

    const stream = document.createElement("div");
    stream.className = "stream";
    stream.style.left = x1 + "px";
    stream.style.top = y1 + "px";
    stream.style.width = length + "px";
    stream.style.background = COLORS[colorIndex].value;
    stream.style.color = COLORS[colorIndex].value;
    stream.style.setProperty("--angle", angle + "deg");
    document.getElementById("streamLayer").appendChild(stream);

    setTimeout(() => {
      source.classList.remove("pouring");
      target.classList.remove("pouring");
      stream.remove();
    }, 460);
  }

  function handleTubeTap(index) {
    if (finished) return;

    if (selected === null) {
      if (!board[index].length) {
        messageEl.textContent = "Choose a tube that contains liquid first.";
        return;
      }
      selected = index;
      messageEl.textContent = "Now choose an empty tube or one with the same top colour.";
      render();
      return;
    }

    if (selected === index) {
      selected = null;
      messageEl.textContent = "Selection cancelled.";
      render();
      return;
    }

    if (canPour(selected, index)) {
      const from = selected, to = index;
      const colorIndex = board[from][board[from].length - 1];
      history.push(cloneBoard(board));
      const amount = Math.min(topRun(board[from]), CAPACITY - board[to].length);

      startTimer();
      for (let i = 0; i < amount; i++) board[to].push(board[from].pop());
      moves++;
      selected = null;
      render();
      animatePour(from, to, colorIndex);

      if (isSolved()) {
        finished = true;
        stopTimer();
        const oldBest = Number(localStorage.getItem(BEST_KEY));
        if (!oldBest || moves < oldBest) {
          localStorage.setItem(BEST_KEY, String(moves));
        }
        updateStats();
        winBanner.style.display = "block";
        messageEl.textContent = "All colours are sorted.";
      } else {
        messageEl.textContent = "Nice pour. Keep sorting!";
      }
      return;
    }

    if (board[index].length) {
      selected = index;
      messageEl.textContent = "Selected tube " + (index + 1) +
        ". Choose a valid destination.";
      render();
    } else {
      messageEl.textContent = "That pour is not allowed.";
    }
  }

  function undo() {
    if (!history.length || finished) return;
    board = history.pop();
    moves = Math.max(0, moves - 1);
    selected = null;
    if (moves === 0) {
      stopTimer();
      started = false;
      seconds = 0;
    }
    winBanner.style.display = "none";
    messageEl.textContent = "Last move undone.";
    render();
  }

  function restart() {
    stopTimer();
    board = cloneBoard(startingBoard);
    history = [];
    selected = null;
    moves = 0;
    seconds = 0;
    started = false;
    finished = false;
    winBanner.style.display = "none";
    messageEl.textContent = "Puzzle restarted. Find the right sequence.";
    render();
  }

  function newGame() {
    stopTimer();
    board = generatePuzzle();
    startingBoard = cloneBoard(board);
    history = [];
    selected = null;
    moves = 0;
    seconds = 0;
    started = false;
    finished = false;
    winBanner.style.display = "none";
    messageEl.textContent = "New solvable puzzle. Tap a tube to begin.";
    render();
  }

  undoBtn.addEventListener("click", undo);
  document.getElementById("restartBtn").addEventListener("click", restart);
  document.getElementById("newBtn").addEventListener("click", newGame);

  bestEl.textContent = localStorage.getItem(BEST_KEY) || "--";
  newGame();
})();
</script>
</body>
</html>
